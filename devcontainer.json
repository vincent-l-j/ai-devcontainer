{
  "name": "GitHub Copilot CLI (Docker)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },

  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],

  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",

  "workspaceMount": "source=${localWorkspaceFolder},target=/Users/v/Documents/repos/technology,type=bind,consistency=delegated",
  "workspaceFolder": "/Users/v/Documents/repos/technology",

  "mounts": [
    "source=devc-${localWorkspaceFolderBasename}-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=devc-${localWorkspaceFolderBasename}-config-${devcontainerId},target=/home/vscode/.copilot,type=volume"
  ],

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": ["GitHub.copilot-chat"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
